# Copy this file to ".env" and set values as needed.
# Vite exposes only variables prefixed with VITE_ to the client, and inlines
# them at build time (set them in the Vercel project settings before deploying).

# Base path for API requests. Defaults to "/api", which the Vite dev proxy
# forwards to the backend, so local development needs no value here.
#
# Live deployment (Vercel -> Environment Variables, name: VITE_API_BASE_URL):
#   https://maintain-iq-backend-dun.vercel.app/api
# The "/api" suffix is required: the backend mounts every route under /api.
VITE_API_BASE_URL=
